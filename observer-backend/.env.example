# ────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────
APP_ENV=dev
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# ────────────────────────────────────────────────
# Database (asyncpg driver)
# ────────────────────────────────────────────────
DB_URL=postgresql+asyncpg://observer:observer@localhost:5433/observer
DB_ECHO=false

# ────────────────────────────────────────────────
# Redis (broker for Celery + app cache later)
# ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ────────────────────────────────────────────────
# Encryption
# ────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The value below is a dev-only dummy (all 'A' bytes, url-safe base64). DO NOT USE IN PROD.
COOKIE_ENC_KEY=bWey3zdLKSyLlvjklQszBpTQr0Kilu7rEbJNcfFtVpw=
SESSION_SECRET=dev-session-secret-change-me-in-prod

# ────────────────────────────────────────────────
# Fetcher defaults
# ────────────────────────────────────────────────
FETCH_USER_AGENT=Observer/0.1 (+https://example.com/bot)
FETCH_TIMEOUT_SECONDS=30
FETCH_DEFAULT_RATE_PER_MIN=6

# ────────────────────────────────────────────────
# Single-user dev mode (real auth deferred)
# ────────────────────────────────────────────────
DEV_USER_EMAIL=me@localhost
DEV_USER_ID=00000000-0000-0000-0000-000000000001
